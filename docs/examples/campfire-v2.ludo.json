    "dialogues": [
      {
        "id": "camp-fire-dialogue",
        "name": "篝火旁的问候",
        "description": "",
        "tags": [],
        "kind": "dialogue",
        "character_id": "camp-xialan",
        "entry_node_id": "greeting",
        "entry_routes": [
          {
            "node_id": "injury",
            "condition": {
              "op": "variable",
              "variable_id": "camp-injured",
              "comparison": "eq",
              "value": true
            }
          }
        ],
        "nodes": [
          {
            "id": "greeting",
            "label": "篝火问候",
            "speaker_id": "camp-xialan",
            "text": "靠近些吧。夜里的风，比白天的沙更难熬。",
            "condition": {
              "op": "always"
            },
            "effects": [],
            "options": [
              {
                "id": "camp-ask-road",
                "text": "明天的路好走吗？",
                "condition": {
                  "op": "always"
                },
                "effects": [],
                "target_node_id": "road"
              },
              {
                "id": "camp-ask-help",
                "text": "我受了点伤，能帮忙看看吗？",
                "condition": {
                  "op": "variable",
                  "variable_id": "camp-injured",
                  "comparison": "eq",
                  "value": true
                },
                "effects": [],
                "target_node_id": "injury"
              },
              {
                "id": "camp-goodbye",
                "text": "谢谢，我坐一会儿就走。",
                "condition": {
                  "op": "always"
                },
                "effects": [],
                "target_node_id": null
              }
            ]
          },
          {
            "id": "road",
            "label": "旅途闲谈",
            "speaker_id": "camp-xialan",
            "text": "沿着路标往东走。至于路上会遇到什么，我也还不知道。",
            "condition": {
              "op": "always"
            },
            "effects": [],
            "options": [
              {
                "id": "camp-road-end",
                "text": "那就明早再决定吧。",
                "condition": {
                  "op": "always"
                },
                "effects": [],
                "target_node_id": null
              }
            ]
          },
          {
            "id": "injury",
            "label": "处理伤口",
            "speaker_id": "camp-xialan",
            "text": "先别急着赶路。去医帐，我给你换一条干净的绷带。",
            "condition": {
              "op": "always"
            },
            "effects": [
              {
                "op": "increment_variable",
                "variable_id": "camp-trust",
                "amount": 1
              }
            ],
            "options": [
              {
                "id": "camp-thanks",
                "text": "谢谢你。",
                "condition": {
                  "op": "always"
                },
                "effects": [],
                "target_node_id": null
              }
            ]
          }
        ]
      },
      {
        "id": "camp-clinic-dialogue",
        "name": "医帐里的叮嘱",
        "description": "",
        "tags": [],
        "kind": "dialogue",
        "character_id": "camp-xialan",
        "entry_node_id": "rest",
        "entry_routes": [],
        "nodes": [
          {
            "id": "rest",
            "label": "医帐叮嘱",
            "speaker_id": "camp-xialan",
            "text": "绷带别沾水。今晚安心睡一觉，天亮后再说。",
            "condition": {
              "op": "always"
            },
            "effects": [],
            "options": [
              {
                "id": "camp-rest-end",
                "text": "我记住了。",
                "condition": {
                  "op": "always"
                },
                "effects": [],
                "target_node_id": null
              }
            ]
          }
        ]
      }
