              {
                "id": "option-rest",
                "text": "Just resting, thank you.",
                "target_node_id": null
              },
              {
                "id": "option-treatment",
                "text": "I am injured. Please help.",
                "condition": {
                  "op": "variable",
                  "variable_id": "var-injured",
                  "value": true
                },
                "target_node_id": "node-treatment"
              }
            ]
          },
          {
            "id": "node-treatment",
            "label": "Treatment",
            "speaker_id": "char-healer",
            "text": "I will clean the wound. Take it easy today.",
            "effects": [
              {
                "op": "set_variable",
                "variable_id": "var-injured",
                "value": false
              },
              {
                "op": "increment_variable",
                "variable_id": "var-trust",
                "amount": 1
              }
            ],
            "options": [
              {
                "id": "option-thanks",
                "text": "Thank you.",
                "target_node_id": null
              }
            ]
          }
        ]
      },
      {
        "id": "dialogue-guard",
        "name": "Guard small talk",
        "character_id": "char-guard",
        "entry_node_id": "node-guard",
