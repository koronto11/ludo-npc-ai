          {
            "id": "node-guard",
            "label": "Small talk",
            "speaker_id": "char-guard",
            "condition": {
              "op": "appearance",
              "level_id": "level-tide-town",
              "appearance_id": "appearance-guard"
            },
            "text": "The wind is strong. Tighten the lamp ropes.",
            "options": [
              {
                "id": "option-guard-end",
                "text": "See you later.",
                "target_node_id": null
              }
            ]
          }
        ]
      },
      {
        "id": "dialogue-ferryman",
        "name": "Ferryman small talk",
        "character_id": "char-ferryman",
        "entry_node_id": "node-ferryman",
